{
  "name": "cardorb",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.vendored.json",
    "format": "prettier --write .",
    "check": "npx prettier --check . && node scripts/extract-theme-values.mjs --check && npm run typecheck && npm run test && npm run lint",
    "tokens": "node scripts/extract-theme-values.mjs",
    "changelog": "node scripts/collect-changelog.mjs",
    "visual": "playwright test",
    "visual:baseline": "playwright test --update-snapshots",
    "ui:add": "node scripts/untitled-add.mjs"
  },
  "dependencies": {
    "@react-types/shared": "^3.36.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@untitledui-pro/icons": "^0.0.3",
    "@vercel/analytics": "^2.0.1",
    "hover-tilt": "^1.0.0",
    "next": "^16.2.1",
    "react": "^19.2.4",
    "react-aria-components": "^1.20.0",
    "react-dom": "^19.2.4",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.10",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.5",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-react-aria-components": "^2.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
