# Untitled UI PRO icons live on the vendor's own registry, not npmjs.
#
# The token is read from the environment on purpose — `${NPM_TOKEN}` is expanded
# by npm at install time, so this file carries no secret and is safe to commit.
# Set it locally with `export NPM_TOKEN=...` and in Vercel as a build-time
# environment variable. Without it, `npm install` fails on the @untitledui-pro
# scope rather than silently falling back.
@untitledui-pro:registry=https://pkg.untitledui.com
//pkg.untitledui.com/:_authToken=${NPM_TOKEN}
